DEBUG=true
SECRET_KEY=replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# For Docker Compose, match PHOTOCHART_PORT and the browser host (127.0.0.1 vs localhost).
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CSRF_TRUSTED_ORIGINS=
# Required for login over HTTP when DEBUG=false; set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_HOST=true
API_ANON_RATE=30/minute
API_USER_RATE=300/minute
LOG_LEVEL=INFO

MEDIA_ROOT=backend/media
DATABASE_PATH=backend/db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost/photochart
LOG_DIR=logs

# Docker Compose production values
POSTGRES_PASSWORD=replace-with-a-long-random-password
PHOTO_LIBRARY_PATH=./photos
PHOTOCHART_PORT=8080
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ORGANIZER_LEASE_SECONDS=86400
ORGANIZER_STALE_JOB_SECONDS=900
METRICS_TOKEN=replace-with-a-long-random-token

# Adapter secrets are referenced by environment-variable name in organizer configs.
# PCLOUD_ACCESS_TOKEN=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# SFTP_USERNAME=
# SFTP_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ingest-from-external-media settings (Docker ingest runner)
# Allow the Celery worker to spawn one-shot containers for external-path ingest.
# Requires /var/run/docker.sock mounted into the worker (see docs/deployment.rst).
# INGEST_DOCKER_ENABLED=false
# Comma-separated host path prefixes the worker is allowed to bind-mount.
# INGEST_ALLOWED_PATH_PREFIXES=/mnt,/media,/run/media
# Container-internal paths always allowed for local ingest (library volume root).
# INGEST_ALWAYS_ALLOWED_PREFIXES=/photos
# Host root bind path: set to /host when worker has -v /:/host:ro so the runner
# can resolve device labels and list mounts for paths not in the container namespace.
# INGEST_HOST_ROOT=/host
# Path to compose.yaml inside the container (default: /app/compose.yaml).
# INGEST_COMPOSE_FILE=/app/compose.yaml
# Docker Compose project name (auto-detected when empty).
# COMPOSE_PROJECT_NAME=photochart
